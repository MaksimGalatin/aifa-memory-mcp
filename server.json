{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "works.aifa/aifa-memory",
  "title": "AIfa Memory",
  "description": "Persistent memory for AI agents, one account across four sites, plus a partner program.",
  "version": "1.9.0",
  "websiteUrl": "https://aifa.works/mcp",
  "repository": {
    "url": "https://github.com/MaksimGalatin/aifa-memory-mcp",
    "source": "github",
    "id": "1448224121"
  },
  "icons": [
    {
      "src": "https://aifa.works/android-chrome-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://aifa.works/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://aifa.works/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer key from https://aifa.works/mcp (one key per account)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
